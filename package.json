{
  "name": "here-context-recall",
  "private": true,
  "version": "0.2.0",
  "description": "Windows-first desktop context recall for interrupted work",
  "author": "Here Hackathon Team",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm test && electron-vite build",
    "build:app": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build:app && electron-builder --win nsis portable --x64 --publish never",
    "dist:win:portable": "npm run build:app && electron-builder --win portable --x64 --publish never",
    "dist:mac": "npm run build:app && electron-builder --mac dmg --arm64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "get-windows": "9.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "framer-motion": "13.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "overrides": {
    "node-gyp": "12.4.0",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.here.contextrecall",
    "productName": "Here",
    "asar": true,
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/get-windows/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "Here-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Here는 사용자가 화면 옵션을 켜고 복원 또는 기억을 직접 실행할 때 활성 창 한 장을 사용합니다.",
        "NSAppleEventsUsageDescription": "Here는 사용자가 허용한 경우 현재 앱과 창 정보를 확인합니다."
      }
    },
    "nsis": {
      "artifactName": "Here-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Here-${version}-Windows-${arch}-Portable.${ext}"
    }
  }
}
